{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "test:unit": "playwright test --project=unit",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update:linux": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.65.1-noble /bin/bash -c \"npm ci && npx playwright test e2e/visual.spec.ts --update-snapshots\"",
    "test:e2e:browsers": "playwright test --project=desktop-chromium --project=mobile-chromium --project=responsive",
    "check:public-build": "node scripts/check-public-build.mjs --serve"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@mswjs/socket.io-binding": "0.2.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "chrome-launcher": "1.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "msw": "2.15.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
